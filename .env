# 部署參數（無任何機密，直接進版控方便主機上 git pull 即用）
PROJECT_CODE=poke_stroll
CONTAINER_NAME=${PROJECT_CODE}
VERSION=0.47.0
IMAGE=asia-east1-docker.pkg.dev/blue-whale-408802/bluewhale-engine/poke-stroll:${VERSION}
PREFIX_MID_NAME=${PROJECT_CODE}
ROUTE_PREFIX=poke-stroll
NETWORK=ipa_service_net
# nginx 容器內固定聽 80
PORT=80
